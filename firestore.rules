rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users can never list the collection of all users
      
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 128
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'companyName', 'defaultCurrency', 'language', 'theme', 'updatedAt'
        ]);

      allow delete: if isOwner(userId);
    }

    // --- Subscriptions Collection ---
    match /subscriptions/{subscriptionId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(subscriptionId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == subscriptionId
        && request.resource.data.serviceName is string && request.resource.data.serviceName.size() <= 128
        && request.resource.data.category in ['Software', 'Entertainment', 'Education', 'Business Tools', 'Cloud Storage', 'Internet', 'Other']
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && request.resource.data.billingCycle in ['Weekly', 'Monthly', 'Quarterly', 'Yearly']
        && request.resource.data.renewalDate is string && request.resource.data.renewalDate.size() <= 32
        && request.resource.data.status in ['Active', 'Paused', 'Expired', 'Cancelled'];

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.amount is number && request.resource.data.amount >= 0;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(paymentId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == paymentId
        && request.resource.data.subscriptionId is string && request.resource.data.subscriptionId.size() <= 128
        && request.resource.data.serviceName is string && request.resource.data.serviceName.size() <= 128
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.currency in ['INR', 'USD', 'EUR', 'GBP']
        && request.resource.data.paymentMethod is string && request.resource.data.paymentMethod.size() <= 64
        && request.resource.data.status in ['Success', 'Pending', 'Failed'];

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == resource.data.id;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Activities Collection ---
    match /activities/{activityId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(activityId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == activityId
        && request.resource.data.type is string && request.resource.data.type.size() <= 64
        && request.resource.data.title is string && request.resource.data.title.size() <= 128;

      allow update: if false; // Activities are append-only audit logs
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
