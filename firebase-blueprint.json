{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing settings, default currency, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 128 },
        "defaultCurrency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP"], "maxLength": 4 },
        "language": { "type": "string", "enum": ["en", "hi", "mr"], "maxLength": 5 },
        "theme": { "type": "string", "enum": ["light", "dark", "system"], "maxLength": 10 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "defaultCurrency"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "A recurring software, tool, or service subscription tracked by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 128 },
        "providerName": { "type": "string", "maxLength": 128 },
        "category": {
          "type": "string",
          "enum": ["Software", "Entertainment", "Education", "Business Tools", "Cloud Storage", "Internet", "Other"],
          "maxLength": 64
        },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP"], "maxLength": 4 },
        "billingCycle": {
          "type": "string",
          "enum": ["Weekly", "Monthly", "Quarterly", "Yearly"],
          "maxLength": 32
        },
        "startDate": { "type": "string", "maxLength": 32 },
        "renewalDate": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 1024 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["Active", "Paused", "Expired", "Cancelled"],
          "maxLength": 32
        },
        "reminderDays": { "type": "array" },
        "customReminderDate": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "serviceName", "category", "amount", "currency", "billingCycle", "renewalDate", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Recorded payment history for a subscription renewal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subscriptionId": { "type": "string", "maxLength": 128 },
        "serviceName": { "type": "string", "maxLength": 128 },
        "paymentDate": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP"], "maxLength": 4 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "transactionRef": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Success", "Pending", "Failed"], "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "subscriptionId", "serviceName", "paymentDate", "amount", "currency", "paymentMethod", "status"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Recent actions and events for user audit and activity feed",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "title", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user preferences, profile, and settings"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "User subscriptions with renewal schedules"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Historical payment transactions for subscriptions"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Audit trail of recent renewal and subscription activities"
    }
  }
}
